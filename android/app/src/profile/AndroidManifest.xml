<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- SECURITY: the INTERNET permission that the stock Flutter template puts
         here has been deliberately REMOVED in every build variant (main,
         debug, profile) so the app is structurally incapable of any network
         call. Consequence: profile mode tooling that needs networking will
         not work; install release builds instead, or temporarily re-add this
         permission for local debugging only. -->
</manifest>
